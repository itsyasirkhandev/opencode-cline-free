---
import "../styles/global.css";

type Props = { title: string; description: string };
const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const repo = "https://github.com/itsyasirkhandev/opencode-cline-free";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "opencode-cline-free",
  description,
  url: canonical,
  codeRepository: repo,
  programmingLanguage: "TypeScript",
  runtimePlatform: "OpenCode V2",
  license: "https://opensource.org/licenses/MIT",
  author: {
    "@type": "Person",
    name: "Yasir Khan",
    url: "https://github.com/itsyasirkhandev",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fcfbf8" />

    <link
      rel="icon"
      href={`${base}favicon.svg?v=free-flight`}
      type="image/svg+xml"
    />
    <link
      rel="icon"
      href={`${base}favicon-32.png?v=free-flight`}
      sizes="32x32"
      type="image/png"
    />
    <link
      rel="apple-touch-icon"
      href={`${base}apple-touch-icon.png?v=free-flight`}
    />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="opencode-cline-free" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="opencode-cline-free: Cline's free models inside OpenCode"
    />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#hero-title" class="skip">
      Skip to content
    </a>
    <slot />
  </body>
</html>
