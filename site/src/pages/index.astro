---
import Layout from "../layouts/Layout.astro";
import CopyCommand from "../components/CopyCommand.astro";
import { HeroSection02 } from "@/components/ui/hero-02";

const title = "opencode-cline-free: Cline's free models in OpenCode";
const description =
  "Use Cline's rotating free models in OpenCode V2. Connect your Cline account for live model discovery, request failover and session pinning.";
const steps = [
  {
    title: "Install the plugin.",
    body: "Run this command in your terminal, then restart OpenCode. The plugin is added to your global configuration.",
    command: "opencode plugin add github:itsyasirkhandev/opencode-cline-free",
    label: "Copy install command",
  },
  {
    title: "Connect your Cline account.",
    body: "Run /connect in OpenCode and choose Cline Free. Approve browser sign-in, reuse a Cline CLI login on this machine, or provide a Cline token.",
    command: "/connect",
    label: "Copy /connect command",
  },
  {
    title: "Choose a free model.",
    body: 'Search for "cline free" in the model picker. Use /variants to choose a reasoning effort your model supports. Models marked (paid) spend Cline credits.',
    command: "/models",
    label: "Copy /models command",
  },
];
---

<Layout title={title} description={description}>
  <main id="main" tabindex="-1">
    <HeroSection02 />
    <div class="wrap launch">
      <section class="launch-hero" id="setup" aria-labelledby="setup-title">
        <div class="launch-heading" data-reveal="fade">
          <p class="eyebrow">Set up in OpenCode</p>
          <h2 id="setup-title">
            Install the plugin.
            <br />
            Connect your account.
          </h2>
          <p class="intro">
            Run the install command in your terminal. Then sign in and choose a
            model inside OpenCode. Requires OpenCode 2.x.
          </p>
        </div>
        <div class="launch-console" data-reveal="fade">
          <ol class="step-menu" hidden>
            <li>
              <button
                type="button"
                data-step="0"
                aria-pressed="true"
                aria-controls="step-content"
              >
                <span class="stepno">01</span>Install
              </button>
            </li>
            <li>
              <button
                type="button"
                data-step="1"
                aria-pressed="false"
                aria-controls="step-content"
              >
                <span class="stepno">02</span>Connect
              </button>
            </li>
            <li>
              <button
                type="button"
                data-step="2"
                aria-pressed="false"
                aria-controls="step-content"
              >
                <span class="stepno">03</span>Choose
              </button>
            </li>
          </ol>
          <section
            id="step-content"
            class="step-content"
            aria-label="Setup instructions"
          >
            {steps.map((step, index) => (
              <div data-step-panel={index}>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <CopyCommand command={step.command} label={step.label} />
              </div>
            ))}
          </section>
        </div>
        <p class="fine">
          This page shows commands. It doesn't run them or sign you in.
          <br />
          Cline's daily free quota applies. Models marked (paid) spend Cline
          credits.
        </p>
      </section>
      <section class="tutorial" id="tutorial" aria-labelledby="tutorial-title">
        <div data-reveal="fade">
          <p class="eyebrow">Video walkthrough</p>
          <h2 id="tutorial-title">Watch the setup in OpenCode.</h2>
          <p class="description">
            Follow the install and sign-in flow on screen. The written steps
            above use the current install command.
          </p>
        </div>
        <div class="video-frame" data-reveal="fade">
          <iframe
            src="https://www.youtube-nocookie.com/embed/xad4Rb9PNTE?playsinline=1"
            title="Full setup tutorial: How to Use Cline AI Models for FREE in OpenCode"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="
                accelerometer;
                clipboard-write;
                encrypted-media;
                gyroscope;
                picture-in-picture;
                web-share;
              "
            allowfullscreen
            aria-describedby="tutorial-note"
          ></iframe>
        </div>
        <div class="tutorial-meta">
          <p id="tutorial-note">
            This tutorial shows an earlier plugin version. Use the current
            install command above; available models may differ. Captions are not
            yet available.
          </p>
          <a href="https://www.youtube.com/watch?v=xad4Rb9PNTE">
            Watch on YouTube <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <section class="support" aria-label="Quotas and account limits">
        <div data-reveal="fade">
          <span class="number">Free quota</span>
          <h2>Daily limits still apply.</h2>
          <p>
            Cline sets a daily free quota for each account and model. The plugin
            tracks cooldowns. It does not remove limits or make paid models
            free.
          </p>
        </div>
        <div data-reveal="fade">
          <span class="number">Account status</span>
          <h2>Check before you switch.</h2>
          <p>
            Ask OpenCode to run <code>cline_free_status</code> to check
            connected accounts, cooldowns and accounts that need a new login.
            Paid-model failover uses the next account's Cline credits.
          </p>
        </div>
      </section>
      <footer class="footer" data-reveal="fade">
        <p>MIT licensed · Yasir Khan</p>
        <nav aria-label="Project resources" class="footer-links">
          <a href="https://github.com/itsyasirkhandev/opencode-cline-free#readme">
            Docs
          </a>
          <a href="https://github.com/itsyasirkhandev/opencode-cline-free">
            GitHub ↗
          </a>
        </nav>
        <p>
          Independent community plugin. Not affiliated with Cline or OpenCode.
        </p>
      </footer>
    </div>
  </main>
  <p id="status" class="sr-only" role="status"></p>
</Layout>

<script>
  const status = document.getElementById("status");
  const stepButtons =
    document.querySelectorAll<HTMLButtonElement>("button[data-step]");
  const panels = document.querySelectorAll<HTMLElement>("[data-step-panel]");

  // All instructions stay readable if JavaScript is unavailable.
  for (const panel of panels) {
    panel.hidden = panel.dataset.stepPanel !== "0";
  }

  for (const button of stepButtons) {
    button.addEventListener("click", () => {
      for (const candidate of stepButtons) {
        candidate.setAttribute("aria-pressed", String(candidate === button));
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.stepPanel !== button.dataset.step;
        if (!panel.hidden && status) {
          status.textContent = `Step ${Number(button.dataset.step) + 1}: ${panel.querySelector("h3")?.textContent ?? ""}`;
        }
      }
    });
  }
  const stepMenu = document.querySelector<HTMLOListElement>(".step-menu");
  if (stepMenu) stepMenu.hidden = false;

  let pressedButton: HTMLButtonElement | undefined;
  function releasePointer() {
    pressedButton?.removeAttribute("data-pointer-press");
    pressedButton = undefined;
  }
  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest(".copy, .step-menu button");
    if (!(button instanceof HTMLButtonElement)) return;
    releasePointer();
    pressedButton = button;
    button.setAttribute("data-pointer-press", "");
  });
  document.addEventListener("pointerup", releasePointer);
  document.addEventListener("pointercancel", releasePointer);
  window.addEventListener("blur", releasePointer);
  document.addEventListener("keydown", releasePointer);
</script>

<script>
  import { setupLandingMotion } from "../lib/landing-motion";

  setupLandingMotion();
</script>
