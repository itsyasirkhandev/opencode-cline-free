---
import Layout from "../layouts/Layout.astro";
import CopyCommand from "../components/CopyCommand.astro";

const logo = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}logo.svg?v=free-flight`;
const title = "opencode-cline-free: Cline's free models in OpenCode";
const description =
  "Use Cline’s rotating free models inside OpenCode V2, with automatic discovery and failover across your connected accounts.";
const steps = [
  {
    title: "Install the plugin.",
    body: "Run this command in your terminal, then restart OpenCode. The plugin is added to your global configuration.",
    command: "opencode plugin add github:itsyasirkhandev/opencode-cline-free",
    label: "Copy install command",
  },
  {
    title: "Connect your Cline account.",
    body: "In OpenCode, choose Cline Free. Sign in in your browser, reuse your Cline CLI login, or provide a token.",
    command: "/connect",
    label: "Copy /connect command",
  },
  {
    title: "Choose a free model.",
    body: "Search for “cline free” in the model picker. Use /variants to choose the reasoning effort your model supports.",
    command: "/models",
    label: "Copy /models command",
  },
];
---

<Layout title={title} description={description}>
  <div class="wrap launch">
    <header class="masthead">
      <a
        class="brand"
        href="https://github.com/itsyasirkhandev/opencode-cline-free"
      >
        <img src={logo} width="32" height="32" alt="" aria-hidden="true" />
        opencode-cline-free
      </a>
      <nav aria-label="Primary">
        <ul class="navlinks">
          <li class="nav-doc">
            <a href="https://github.com/itsyasirkhandev/opencode-cline-free#readme">
              Docs
            </a>
          </li>
          <li>
            <a href="https://github.com/itsyasirkhandev/opencode-cline-free">
              GitHub ↗
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="launch-hero">
        <div class="launch-heading">
          <p class="eyebrow motion-entry entry-1">
            Your Cline account. Your OpenCode workflow.
          </p>
          <h1 class="motion-entry entry-2">
            Free models.
            <br />
            Three steps away.
          </h1>
          <p class="intro motion-entry entry-3">
            Use Cline’s rotating free models inside OpenCode V2, with automatic
            discovery and failover across your connected accounts.
          </p>
        </div>
        <div class="launch-console motion-entry entry-4">
          <ol class="step-menu">
            <li>
              <button
                type="button"
                data-step="0"
                aria-pressed="true"
                aria-controls="step-content"
              >
                <span class="stepno">01</span>Install
              </button>
            </li>
            <li>
              <button
                type="button"
                data-step="1"
                aria-pressed="false"
                aria-controls="step-content"
              >
                <span class="stepno">02</span>Connect
              </button>
            </li>
            <li>
              <button
                type="button"
                data-step="2"
                aria-pressed="false"
                aria-controls="step-content"
              >
                <span class="stepno">03</span>Choose
              </button>
            </li>
          </ol>
          <section
            id="step-content"
            class="step-content"
            aria-label="Setup instructions"
          >
            {steps.map((step, index) => (
              <div data-step-panel={index} hidden={index !== 0}>
                <h2>{step.title}</h2>
                <p>{step.body}</p>
                <CopyCommand command={step.command} label={step.label} />
              </div>
            ))}
          </section>
        </div>
        <p class="fine motion-entry entry-5">
          Setup guide — run these commands in OpenCode, not on this page.
          Requires OpenCode 2.x.
          <br />
          Cline’s daily free quota applies. Models marked (paid) spend Cline
          credits.
        </p>
      </section>
      <section class="tutorial" id="tutorial" aria-labelledby="tutorial-title">
        <p class="eyebrow">VIDEO WALKTHROUGH</p>
        <h2 id="tutorial-title">Watch the full setup tutorial.</h2>
        <p class="description">
          Follow the walkthrough to install the plugin, connect your Cline
          account, and choose a model in OpenCode.
        </p>
        <div class="video-frame">
          <iframe
            src="https://www.youtube-nocookie.com/embed/xad4Rb9PNTE?playsinline=1"
            title="Full setup tutorial: How to Use Cline AI Models for FREE in OpenCode"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="
                accelerometer;
                clipboard-write;
                encrypted-media;
                gyroscope;
                picture-in-picture;
                web-share;
              "
            allowfullscreen
            aria-describedby="tutorial-note"
          ></iframe>
        </div>
        <div class="tutorial-meta">
          <p id="tutorial-note">
            This tutorial shows an earlier plugin version. Use the current
            install command above; available models may differ. Captions are not
            yet available.
          </p>
          <a href="https://www.youtube.com/watch?v=xad4Rb9PNTE">
            Watch on YouTube <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <section class="support" aria-label="Plugin capabilities">
        <div>
          <span class="number">01 / DISCOVER</span>
          <h2>Models that keep up.</h2>
          <p>
            The free list refreshes from Cline. New rotations don’t need a
            plugin update.
          </p>
        </div>
        <div>
          <span class="number">02 / CONNECT</span>
          <h2>Your accounts, together.</h2>
          <p>
            Use browser sign-in, reuse your Cline CLI login, or connect with a
            token.
          </p>
        </div>
        <div>
          <span class="number">03 / CONTINUE</span>
          <h2>A limit isn’t the end.</h2>
          <p>
            When an account is capped, retry on the next healthy connected
            account.
          </p>
        </div>
      </section>
    </main>
    <footer class="footer">
      <p>MIT licensed · Yasir Khan</p>
      <p>
        Independent community plugin. Not affiliated with Cline or OpenCode.
      </p>
    </footer>
  </div>
  <p id="status" class="sr-only" role="status"></p>
</Layout>

<script>
  const status = document.getElementById("status");
  const stepButtons =
    document.querySelectorAll<HTMLButtonElement>("button[data-step]");
  const panels = document.querySelectorAll<HTMLElement>("[data-step-panel]");

  for (const button of stepButtons) {
    button.addEventListener("click", () => {
      for (const candidate of stepButtons) {
        candidate.setAttribute("aria-pressed", String(candidate === button));
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.stepPanel !== button.dataset.step;
        if (!panel.hidden && status) {
          status.textContent = `Step ${Number(button.dataset.step) + 1}: ${panel.querySelector("h2")?.textContent ?? ""}`;
        }
      }
    });
  }

  let pressedButton: HTMLButtonElement | undefined;
  function releasePointer() {
    pressedButton?.removeAttribute("data-pointer-press");
    pressedButton = undefined;
  }
  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest(".copy, .step-menu button");
    if (!(button instanceof HTMLButtonElement)) return;
    releasePointer();
    pressedButton = button;
    button.setAttribute("data-pointer-press", "");
  });
  document.addEventListener("pointerup", releasePointer);
  document.addEventListener("pointercancel", releasePointer);
  window.addEventListener("blur", releasePointer);
  document.addEventListener("keydown", releasePointer);
</script>
