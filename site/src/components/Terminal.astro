---
type Line = { kind: "cmd" | "comment" | "tui"; text: string; hint?: string };
const lines: Line[] = [
  {
    kind: "cmd",
    text: "opencode plugin add github:itsyasirkhandev/opencode-cline-free",
  },
  { kind: "comment", text: "# then, inside OpenCode:" },
  { kind: "tui", text: "/connect", hint: "Cline Free → Cline account" },
  { kind: "tui", text: "/models", hint: "Muse Spark 1.3 Contributor (free)" },
  {
    kind: "tui",
    text: "/variants",
    hint: "minimal · low · medium · high · xhigh",
  },
];
---

<figure class="terminal overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900 shadow-2xl shadow-black/40">
  <div
    class="flex items-center gap-2 border-b border-neutral-800 px-4 py-3"
    aria-hidden="true"
  >
    <span class="size-3 rounded-full bg-neutral-700"></span>
    <span class="size-3 rounded-full bg-neutral-700"></span>
    <span class="size-3 rounded-full bg-neutral-700"></span>
    <span class="ml-2 font-mono text-xs text-neutral-400">~/my-app</span>
  </div>
  <div class="space-y-1.5 p-5 font-mono text-xs leading-6 sm:text-sm">
    {lines.map((l, i) => (
      <p class="term-line whitespace-pre-wrap wrap-anywhere" style={`--i:${i}`}>
        {l.kind === "cmd" && (
          <>
            <span class="text-neutral-400 select-none" aria-hidden="true">
              ${" "}
            </span>
            <span class="text-neutral-100">{l.text}</span>
          </>
        )}
        {l.kind === "comment" && <span class="text-neutral-400">{l.text}</span>}
        {l.kind === "tui" && (
          <>
            <span class="text-orange-400">{l.text.padEnd(10, " ")}</span>
            <span class="text-neutral-400" aria-hidden="true">
              →{" "}
            </span>
            <span class="text-neutral-200">{l.hint}</span>
          </>
        )}
      </p>
    ))}
    <p class="term-line" style={`--i:${lines.length}`} aria-hidden="true">
      <span class="text-neutral-400 select-none">$ </span>
      <span class="cursor inline-block h-4 w-2 translate-y-0.5 bg-neutral-300"></span>
    </p>
  </div>
  <figcaption class="sr-only">
    Install the plugin with one command, then connect your Cline account and
    pick a free model inside OpenCode.
  </figcaption>
</figure>

<script>
  // Run the cursor blink only while the terminal is on screen.
  const term = document.querySelector(".terminal");
  if (term) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) term.setAttribute("data-onscreen", "");
      else term.removeAttribute("data-onscreen");
    }).observe(term);
  }
</script>
